# =============================================================================
# KATDICT-SPIMP environment configuration
# Copy to .env for local development. NEVER commit real secrets.
# All variables below are SERVER-ONLY. This application intentionally defines
# no NEXT_PUBLIC_ variables; nothing here is exposed to the browser.
# =============================================================================

# --- Database (PostgreSQL) ----------------------------------------------------
# Runtime connection. In production use the provider's POOLED connection string
# (e.g. Neon "-pooler" host, Supabase pooler port 6543) with sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/katdict?sslmode=require"
# Direct (non-pooled) connection used only by `prisma migrate deploy`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/katdict?sslmode=require"
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# --- Application ----------------------------------------------------------------
# Public base URL used in email links (no trailing slash).
APP_URL="https://spimp.example.gov.ng"
# 32+ random characters. Signs nothing client-side; derives the key that
# encrypts TOTP secrets at rest. Generate: openssl rand -base64 48
# Rotating it invalidates enrolled MFA secrets (users must re-enrol).
AUTH_SECRET=""
# Session lifetime controls (minutes of inactivity / absolute hours).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOG_LEVEL="info"   # debug | info | warn | error

# --- Email (transactional) ----------------------------------------------------
# "console" logs emails (development only). "resend" sends via Resend.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Must be a sender on a domain verified with the provider.
EMAIL_FROM="KATDICT SPIMP <no-reply@spimp.example.gov.ng>"

# --- File storage (private S3-compatible bucket) ------------------------------
# "local" is for development only and is refused when NODE_ENV=production.
STORAGE_DRIVER="s3"
OBJECT_STORAGE_ENDPOINT=""      # blank for AWS S3; e.g. https://<account>.r2.cloudflarestorage.com for R2
OBJECT_STORAGE_REGION="auto"    # e.g. eu-west-1 for AWS; "auto" for R2
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
# OBJECT_STORAGE_SSE=none       # set only if the provider rejects SSE headers
# Max upload size in bytes. Vercel functions accept request bodies up to ~4.5 MB.
FILE_UPLOAD_MAX_SIZE=4194304
# Optional malware scanning webhook (POST bytes, expects {"verdict":"clean"}).
# Without it, files are stored as NOT_SCANNED. If set and unreachable, uploads are quarantined.
# MALWARE_SCAN_WEBHOOK_URL=""

# --- AI (optional) ----------------------------------------------------------------
# "disabled" keeps all features working with deterministic rule-based fallbacks.
# Enabling also requires the in-app setting ai.externalProcessingApproved=true
# (data-governance approval) before any record content leaves the platform.
AI_PROVIDER="disabled"          # disabled | anthropic
AI_API_KEY=""
AI_MODEL="claude-opus-5-5"
AI_TIMEOUT_MS=45000
AI_MAX_CALLS_PER_USER_PER_HOUR=60

# --- Scheduled jobs ---------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=""

# --- First deployment only (prisma/seed.ts) -----------------------------------
# Creates the initial Super Administrator, then REMOVE these variables.
# SEED_SUPER_ADMIN_EMAIL=""
# SEED_SUPER_ADMIN_NAME=""
# SEED_SUPER_ADMIN_PASSWORD=""

# --- Tests (local/CI only) ----------------------------------------------------------
# TEST_DATABASE_URL="postgresql://katdict:katdict@localhost:5432/katdict_test"
# E2E_DATABASE_URL="postgresql://katdict:katdict@localhost:5432/katdict_e2e"
# PLAYWRIGHT_CHROMIUM_PATH=""   # use a preinstalled Chromium instead of downloading
